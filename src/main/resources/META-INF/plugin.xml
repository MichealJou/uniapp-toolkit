
<idea-plugin>
    <id>com.greenleafcat.uniapptoolkit</id>
    <name>uniapp-toolkit</name>
    <vendor>michael jou</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.javascript.debugger</depends>
    <depends>org.jetbrains.plugins.vue</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 运行配置 -->
        <configurationType implementation="com.greenleafcat.uniapptoolkit.run.UniAppRunConfigurationType"/>
        <runConfigurationProducer implementation="com.greenleafcat.uniapptoolkit.run.producer.UniAppRunConfigurationProducer"/>

        <!-- 设置页面 -->
        <applicationConfigurable
                parentId="tools"
                instance="com.greenleafcat.uniapptoolkit.settings.UniAppSettingsConfigurable"
                id="com.greenleafcat.uniapptoolkit.settings.UniAppSettingsConfigurable"
                displayName="Uni-app Support"/>

        <!-- uni-ui 组件代码补全 -->
        <webSymbols.web-types source="web-types.json"/>
    </extensions>

</idea-plugin>
